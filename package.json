{
  "name": "cloud-base",
  "version": "1.0.0",
  "private": true,
  "description": "Cloud Base Monorepo",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev:portal": "npm run dev --workspace=apps/user-portal",
    "dev:admapi": "npm run dev --workspace=services/admin-api",
    "dev:admportal": "npm run dev --workspace=apps/admin-portal",
    "dev:admuploadapi": "npm run dev --workspace=services/upload-api",
    "dev:chat": "npm run dev --workspace=apps/chat-portal",
    "dev:chatapi": "npm run dev --workspace=services/chat-api",
    "dev:account": "npm run dev --workspace=apps/account-portal",
    "dev:accountapi": "npm run dev --workspace=services/account-api",
    "dev": "npx concurrently \"npm run dev:portal\" \"npm run dev:admportal\" \"npm run dev:admapi\" \"npm run dev:admuploadapi\" \"npm run dev:chat\" \"npm run dev:chatapi\" \"npm run dev:account\" \"npm run dev:accountapi\"",
    "install:all": "npm install"
  },
  "devDependencies": {
    "@google/stitch-sdk": "^0.3.5",
    "@tailwindcss/postcss": "^4.3.3",
    "concurrently": "^8.2.2",
    "tailwindcss": "^4.3.3"
  },
  "dependencies": {
    "axios": "^1.15.0",
    "lightningcss": "^1.33.0",
    "lucide-react": "^1.8.0",
    "socket.io-client": "^4.8.3"
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "unrs-resolver@1.11.1": true
  }
}
